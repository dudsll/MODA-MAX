@model modamax.web.ViewModels.EsqueciSenhaViewModel

@{
    ViewData["Title"] = "Recuperar Senha";
}

<div class="auth-shell">
    <div class="content-card auth-card">
        <p class="section-kicker">Recuperação</p>
        <h1>Esqueci minha senha</h1>
        <p class="text-muted">Informe o e-mail da sua conta. Vamos enviar um link para você criar uma nova senha.</p>

        @if (TempData["Mensagem"] != null)
        {
            <div class="alert alert-success" role="status">@TempData["Mensagem"]</div>
        }

        @if (TempData["LinkDesenvolvimento"] is string link)
        {
            <div class="alert alert-warning" role="status">
                <strong>Modo desenvolvimento:</strong> o envio de e-mail não está configurado.
                <a href="@link">Abrir o link de redefinição</a>
            </div>
        }

        <form asp-action="RecuperarSenha" class="row g-3 mt-2">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="col-12">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Enviar link</button>
                <a class="btn btn-outline-secondary" asp-action="Login">Voltar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
