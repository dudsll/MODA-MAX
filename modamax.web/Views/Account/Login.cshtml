@model modamax.web.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Entrar";
}

<div class="auth-shell">
    <section class="auth-apresentacao">
        <span class="marca-logo" style="width:3.25rem;height:3.25rem;font-size:1.5rem;border-radius:0.9rem" aria-hidden="true">M</span>
        <h1>Vendas, estoque e clientes.<br /><span>Tudo em um só lugar.</span></h1>
        <p>A ModaMax reúne a loja, o atacado e a equipe de vendas em um sistema único, na Web e no celular.</p>
        <ul class="auth-recursos">
            <li><svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-target" /></svg>Metas em tempo real</li>
            <li><svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-scan-barcode" /></svg>Leitor de etiquetas</li>
            <li><svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-qr-code" /></svg>PIX no pedido</li>
            <li><svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-package" /></svg>Reposição inteligente</li>
        </ul>
    </section>

    <div class="content-card auth-card">
        <h2>Entrar</h2>
        <p class="text-muted mb-4">Use o seu e-mail corporativo.</p>
        <form asp-action="Login" class="d-grid gap-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div>
                <label asp-for="Email" class="form-label">E-mail</label>
                <input asp-for="Email" class="form-control" autocomplete="username" placeholder="nome@modamax.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Senha" class="form-label"></label>
                <input asp-for="Senha" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Senha" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-lg">Entrar</button>
            <a class="text-center" asp-action="RecuperarSenha">Esqueceu a senha?</a>
        </form>
        @if (TempData["Mensagem"] != null)
        {
            <div class="alert alert-success mt-3 mb-0">@TempData["Mensagem"]</div>
        }
        <div class="auth-demo">
            <strong>Acessos de demonstração</strong> (senha <code>123456</code>):<br />
            <code>estrategico@modamax.com</code> · <code>tatico@modamax.com</code> · <code>operacional@modamax.com</code>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
