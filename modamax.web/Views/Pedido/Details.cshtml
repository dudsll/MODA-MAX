@using modamax.web.Services
@model modamax.web.Models.Pedido
@{
    ViewData["Title"] = $"Pedido #{Model.IdPedido}";
    var cancelado = Model.Status == PedidoService.StatusCancelado;
    var classeStatus = Model.Status switch { "Finalizado" => "status-verde", "Cancelado" => "status-vermelho", _ => "status-laranja" };
    var classePagamento = Model.StatusPagamento switch { Pagamentos.Pago => "status-verde", Pagamentos.Estornado => "status-roxo", _ => "status-laranja" };
    var pixPayload = ViewBag.PixPayload as string;
    var pixSvg = ViewBag.PixSvg as string;
    var nivel = Context.Session.GetString("UsuarioNivel");
}

<div class="page-header">
    <div>
        <p class="section-kicker">Vendas · @Model.DataPedido.ToString("dd 'de' MMMM 'de' yyyy")</p>
        <h1>Pedido #@Model.IdPedido</h1>
        <div class="d-flex gap-2 mt-2">
            <span class="status @classeStatus">@Model.Status</span>
            <span class="status @classePagamento">Pagamento @Model.StatusPagamento.ToLower()</span>
            <span class="status status-azul">@Model.TiposVenda</span>
        </div>
    </div>
    <div class="header-actions">
        <a class="btn btn-outline-secondary" asp-action="Index">Voltar</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.IdPedido">
            <svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-pencil" /></svg>Editar
        </a>
    </div>
</div>

@if (TempData["Mensagem"] != null)
{
    <div class="aviso-flutuante" role="status"><svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-circle-check" /></svg>@TempData["Mensagem"]</div>
}
@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}

<div class="content-grid">
    <article class="content-card details-card">
        <div class="section-heading"><div><p class="section-kicker">Resumo</p><h2>@Model.Cliente?.Nome</h2></div></div>
        <dl class="row mb-0">
            <dt class="col-sm-5">Cliente</dt><dd class="col-sm-7"><a asp-controller="Cliente" asp-action="Details" asp-route-id="@Model.IdCliente">@Model.Cliente?.Nome</a></dd>
            <dt class="col-sm-5">Data</dt><dd class="col-sm-7">@Model.DataPedido.ToString("dd/MM/yyyy HH:mm")</dd>
            <dt class="col-sm-5">Tipo de venda</dt><dd class="col-sm-7">@Model.TiposVenda</dd>
            <dt class="col-sm-5">Itens</dt><dd class="col-sm-7">@Model.Itens.Sum(i => i.Quantidade) peça(s) em @Model.Itens.Count produto(s)</dd>
            <dt class="col-sm-5">Valor total</dt><dd class="col-sm-7"><strong style="font-size:1.25rem">@Model.ValorTotal.ToString("C")</strong></dd>
        </dl>
    </article>

    <article class="content-card">
        <div class="section-heading">
            <div><p class="section-kicker">Pagamento</p><h2>@Pagamentos.Nome(Model.FormaPagamento)@(Model.Parcelas > 1 ? $" em {Model.Parcelas}x" : "")</h2></div>
            <span class="status @classePagamento">@Model.StatusPagamento</span>
        </div>

        @if (pixPayload != null && pixSvg != null)
        {
            <div class="pix">
                <div class="pix-qr" aria-label="QR Code PIX de @Model.ValorTotal.ToString("C")" role="img">
                    @* SVG gerado pelo QRCoder a partir do payload do PIX. *@
                    @Html.Raw(pixSvg)
                </div>
                <div>
                    <p class="mb-2">Aponte a câmera do app do banco para o QR Code ou use o PIX copia e cola:</p>
                    <div class="copia-cola mb-3">
                        <input class="form-control" id="pix-copia-cola" value="@pixPayload" readonly aria-label="PIX copia e cola" />
                        <button type="button" class="btn btn-outline-primary" data-copiar="#pix-copia-cola">
                            <svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-copy" /></svg>Copiar
                        </button>
                    </div>
                    <p class="form-text">Chave PIX de demonstração (a ModaMax é uma empresa fictícia). Identificador: PEDIDO@(Model.IdPedido).</p>
                </div>
            </div>
        }
        else
        {
            <dl class="row mb-0 details-card">
                <dt class="col-sm-5">Forma</dt><dd class="col-sm-7">@Pagamentos.Nome(Model.FormaPagamento)</dd>
                @if (Model.Parcelas > 1)
                {
                    <dt class="col-sm-5">Parcelas</dt><dd class="col-sm-7">@Model.Parcelas x de @((Model.ValorTotal / Model.Parcelas).ToString("C"))</dd>
                }
                <dt class="col-sm-5">Situação</dt><dd class="col-sm-7">@Model.StatusPagamento</dd>
                @if (Model.PagoEm.HasValue)
                {
                    <dt class="col-sm-5">Pago em</dt><dd class="col-sm-7">@Model.PagoEm.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                }
            </dl>
        }

        @if (!cancelado && Model.StatusPagamento == Pagamentos.Pendente)
        {
            <form asp-action="ConfirmarPagamento" asp-route-id="@Model.IdPedido" method="post" class="mt-3">
                <button class="btn btn-success" type="submit">
                    <svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-circle-check" /></svg>Confirmar pagamento
                </button>
            </form>
        }
        @if (Model.StatusPagamento == Pagamentos.Estornado)
        {
            <p class="text-muted mt-3 mb-0">O pedido foi cancelado depois de pago: o valor deve ser devolvido ao cliente.</p>
        }
    </article>
</div>

<article class="content-card" style="margin-top:1.25rem">
    <div class="section-heading">
        <div><p class="section-kicker">Itens</p><h2>Produtos do pedido</h2></div>
    </div>
    <div class="table-responsive">
        <table class="table table-modern">
            <thead><tr><th>Produto</th><th class="text-end">Qtd</th><th class="text-end">Preço unit.</th><th class="text-end">Desconto</th><th class="text-end">Subtotal</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Itens)
            {
                <tr>
                    <td>
                        <a class="produto-nome" asp-controller="Produto" asp-action="Details" asp-route-id="@item.IdProduto" style="color:inherit">
                            @if (!string.IsNullOrEmpty(item.Produto?.FotoUrl))
                            {
                                <img class="produto-foto-mini" src="@item.Produto.FotoUrl" alt="" />
                            }
                            else
                            {
                                <span class="produto-foto-mini produto-sem-foto" aria-hidden="true">@(item.Produto?.Nome[..1])</span>
                            }
                            <span>@item.Produto?.Nome<small class="d-block text-muted">Tam. @item.Produto?.Tamanho · @item.Produto?.Cor</small></span>
                        </a>
                    </td>
                    <td class="text-end">@item.Quantidade</td>
                    <td class="text-end">@item.PrecoUnitario.ToString("C")</td>
                    <td class="text-end">@item.Desconto.ToString("C")</td>
                    <td class="text-end"><strong>@((item.PrecoUnitario * item.Quantidade - item.Desconto).ToString("C"))</strong></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (!cancelado && nivel != "Operacional")
    {
        <form asp-action="Cancelar" method="post" asp-route-id="@Model.IdPedido" class="mt-3" onsubmit="return confirm('Cancelar o pedido e devolver os itens ao estoque?');">
            <button class="btn btn-outline-danger" type="submit">Cancelar pedido</button>
        </form>
    }
</article>
