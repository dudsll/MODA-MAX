@model IEnumerable<modamax.web.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="page-header">
    <div>
        <p class="section-kicker">Cadastros</p>
        <h1>Clientes</h1>
        <p class="page-copy">Gerencie os dados de clientes e acompanhe o relacionamento com a loja.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Novo cliente</a>
</div>

<div class="content-card">
    <div class="table-responsive">
        <table class="table table-modern align-middle">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nome</th>
                    <th>Documento</th>
                    <th>Email</th>
                    <th>Telefone</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdCliente</td>
                    <td>@item.Nome</td>
                    <td>@item.Documento</td>
                    <td>@item.Email</td>
                    <td>@item.Telefone</td>
                    <td class="text-end">
                        <span class="acoes-linha"><a asp-action="Details" asp-route-id="@item.IdCliente" aria-label="Detalhes" title="Detalhes"><svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-eye" /></svg></a><a asp-action="Edit" asp-route-id="@item.IdCliente" aria-label="Editar" title="Editar"><svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-pencil" /></svg></a><a class="perigo" asp-action="Delete" asp-route-id="@item.IdCliente" aria-label="Excluir" title="Excluir"><svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-trash-2" /></svg></a></span>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
