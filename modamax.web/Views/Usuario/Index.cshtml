@model IEnumerable<modamax.web.Models.Usuario>
@{ ViewData["Title"] = "Usuários"; }
<div class="page-header"><div><p class="section-kicker">Segurança</p><h1>Usuários</h1></div><a class="btn btn-primary" asp-action="Create">Novo usuário</a></div>
<div class="content-card"><div class="table-responsive"><table class="table table-modern"><thead><tr><th>Nome</th><th>Email</th><th>Nível</th><th class="text-end">Ações</th></tr></thead><tbody>
@foreach (var item in Model) {
<tr><td>@item.Nome</td><td>@item.Email</td><td>@item.Nivel</td><td class="text-end"><span class="acoes-linha"><a asp-action="Details" asp-route-id="@item.IdUsuario" aria-label="Detalhes" title="Detalhes"><svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-eye" /></svg></a><a asp-action="Edit" asp-route-id="@item.IdUsuario" aria-label="Editar" title="Editar"><svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-pencil" /></svg></a><a class="perigo" asp-action="Delete" asp-route-id="@item.IdUsuario" aria-label="Excluir" title="Excluir"><svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-trash-2" /></svg></a></span></td></tr>
}
</tbody></table></div></div>
