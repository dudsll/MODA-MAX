@using Microsoft.AspNetCore.Http
@inject modamax.web.Services.ReposicaoService Reposicao
@{
    var usuarioNome = Context.Session.GetString("UsuarioNome");
    var usuarioNivel = Context.Session.GetString("UsuarioNivel");
    var usuarioNivelExibicao = usuarioNivel switch
    {
        "Estrategico" => "Estratégico",
        "Tatico" => "Tático",
        _ => usuarioNivel
    };
    var logado = !string.IsNullOrWhiteSpace(usuarioNome);
    var estrategico = usuarioNivelExibicao == "Estratégico";
    var gerencia = estrategico || usuarioNivelExibicao == "Tático";
    var iniciais = string.Concat((usuarioNome ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0]));
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var acao = ViewContext.RouteData.Values["action"]?.ToString();
    var produtosParaRepor = logado ? await Reposicao.ContarParaReporAsync() : 0;

    string Ativo(string c, string? a = null) =>
        string.Equals(controlador, c, StringComparison.OrdinalIgnoreCase) &&
        (a == null || string.Equals(acao, a, StringComparison.OrdinalIgnoreCase)) ? "sidebar-link ativo" : "sidebar-link";
}

<!DOCTYPE html>
<html lang="pt-BR" data-theme="light" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] · ModaMax</title>
    <meta name="description" content="ModaMax – gestão comercial integrada de vendas, estoque e clientes." />
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="ModaMax" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" href="~/img/icone.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/img/icone-180.png" />
    @* Aplica o tema salvo (ou o do sistema) antes de desenhar a pagina, para nao piscar. *@
    <script>
        (function () {
            var tema = null;
            try { tema = localStorage.getItem('modamax-tema'); } catch (e) { }
            if (tema !== 'dark' && tema !== 'light') {
                tema = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-theme', tema);
            document.documentElement.setAttribute('data-bs-theme', tema);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(logado ? "" : "publico")">
    <a class="pular-conteudo" href="#conteudo">Pular para o conteúdo</a>

    @if (logado)
    {
        <div class="app-shell">
            <aside class="sidebar" id="sidebar" aria-label="Navegação">
                <a class="sidebar-marca" asp-controller="Home" asp-action="Index">
                    <span class="marca-logo" aria-hidden="true">M</span>
                    <span><strong>ModaMax</strong><small>Gestão comercial</small></span>
                </a>

                <button type="button" class="botao-busca" data-abrir-busca>
                    <svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-search" /></svg>
                    Buscar
                    <span class="atalho" aria-hidden="true">⌘K</span>
                </button>

                <nav aria-label="Menu principal">
                    <p class="sidebar-secao">Visão geral</p>
                    <a class="@Ativo("Home")" asp-controller="Home" asp-action="Index">
                        <svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-layout-dashboard" /></svg>Painel
                    </a>
                    <a class="@Ativo("Meta")" asp-controller="Meta" asp-action="Index">
                        <svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-target" /></svg>Metas
                    </a>

                    <p class="sidebar-secao">Vendas</p>
                    <a class="@(Ativo("Pedido") == "sidebar-link ativo" && acao != "Historico" ? "sidebar-link ativo" : "sidebar-link")" asp-controller="Pedido" asp-action="Index">
                        <svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-receipt" /></svg>Pedidos
                    </a>
                    <a class="@Ativo("Pedido", "Historico")" asp-controller="Pedido" asp-action="Historico">
                        <svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-history" /></svg>Histórico
                    </a>
                    <a class="@Ativo("Cliente")" asp-controller="Cliente" asp-action="Index">
                        <svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-users" /></svg>Clientes
                    </a>

                    <p class="sidebar-secao">Catálogo</p>
                    <a class="@Ativo("Produto")" asp-controller="Produto" asp-action="Index">
                        <svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-shirt" /></svg>Produtos
                    </a>
                    <a class="@Ativo("Categoria")" asp-controller="Categoria" asp-action="Index">
                        <svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-tags" /></svg>Categorias
                    </a>
                    <a class="@Ativo("Reposicao")" asp-controller="Reposicao" asp-action="Index">
                        <svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-package" /></svg>Reposição
                        @if (produtosParaRepor > 0)
                        {
                            <span class="contador" aria-label="@produtosParaRepor produtos para repor">@produtosParaRepor</span>
                        }
                    </a>
                    <a class="@Ativo("Etiqueta")" asp-controller="Etiqueta" asp-action="Index">
                        <svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-printer" /></svg>Etiquetas
                    </a>

                    @if (gerencia)
                    {
                        <p class="sidebar-secao">Análises</p>
                        <a class="@Ativo("Relatorio", "Index")" asp-controller="Relatorio" asp-action="Index">
                            <svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-chart-column" /></svg>Relatórios
                        </a>
                        <a class="@Ativo("Relatorio", "CurvaAbc")" asp-controller="Relatorio" asp-action="CurvaAbc">
                            <svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-chart-pie" /></svg>Curva ABC
                        </a>
                    }

                    @if (estrategico)
                    {
                        <p class="sidebar-secao">Administração</p>
                        <a class="@Ativo("Usuario")" asp-controller="Usuario" asp-action="Index">
                            <svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-user-cog" /></svg>Usuários
                        </a>
                        <a class="@Ativo("Log")" asp-controller="Log" asp-action="Index">
                            <svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-scroll-text" /></svg>Auditoria
                        </a>
                    }
                </nav>

                <div class="sidebar-rodape">
                    <div class="usuario-cartao">
                        <span class="avatar" aria-hidden="true">@iniciais</span>
                        <span><strong>@usuarioNome</strong><small>@usuarioNivelExibicao</small></span>
                    </div>
                    <div class="sidebar-acoes">
                        <button type="button" class="botao-icone" data-alternar-tema aria-label="Alternar entre tema claro e escuro" title="Tema claro/escuro">
                            <svg class="icone tema-claro-icone" aria-hidden="true"><use href="/img/icones.svg#i-moon" /></svg>
                            <svg class="icone tema-escuro-icone" aria-hidden="true"><use href="/img/icones.svg#i-sun" /></svg>
                        </button>
                        <a class="botao-icone botao-texto" asp-controller="Account" asp-action="Logout">
                            <svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-log-out" /></svg>Sair
                        </a>
                    </div>
                </div>
            </aside>
            <div class="sidebar-fundo" data-fechar-menu></div>

            <div class="app-main">
                <header class="topbar">
                    <button type="button" class="botao-icone" data-abrir-menu aria-label="Abrir menu" aria-controls="sidebar">
                        <svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-menu" /></svg>
                    </button>
                    <a class="sidebar-marca" asp-controller="Home" asp-action="Index">
                        <span class="marca-logo" aria-hidden="true">M</span><strong>ModaMax</strong>
                    </a>
                    <div class="topbar-acoes">
                        <button type="button" class="botao-icone" data-abrir-busca aria-label="Buscar">
                            <svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-search" /></svg>
                        </button>
                        <button type="button" class="botao-icone" data-alternar-tema aria-label="Alternar entre tema claro e escuro">
                            <svg class="icone tema-claro-icone" aria-hidden="true"><use href="/img/icones.svg#i-moon" /></svg>
                            <svg class="icone tema-escuro-icone" aria-hidden="true"><use href="/img/icones.svg#i-sun" /></svg>
                        </button>
                    </div>
                </header>

                <main id="conteudo" class="conteudo">
                    @RenderBody()
                </main>
            </div>
        </div>

        @* Busca global no estilo Spotlight: Cmd+K / Ctrl+K em qualquer tela. *@
        <div class="spotlight" id="spotlight" hidden role="dialog" aria-modal="true" aria-label="Busca global">
            <div class="spotlight-painel">
                <div class="spotlight-campo">
                    <svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-search" /></svg>
                    <input type="search" id="spotlight-campo" placeholder="Buscar produtos, clientes, pedidos e telas"
                           autocomplete="off" aria-controls="spotlight-resultados" aria-label="Termo de busca" />
                    <kbd>esc</kbd>
                </div>
                <ul class="spotlight-resultados" id="spotlight-resultados" role="listbox"></ul>
                <div class="spotlight-rodape" aria-hidden="true">
                    <span><kbd>↑</kbd> <kbd>↓</kbd> navegar</span>
                    <span><kbd>↵</kbd> abrir</span>
                    <span>Dica: digite o número do pedido ou o código de barras</span>
                </div>
            </div>
        </div>
    }
    else
    {
        <main id="conteudo" class="conteudo">
            @RenderBody()
        </main>
    }

    @* VLibras: tradutor oficial de Portugues para LIBRAS do Governo Federal (vlibras.gov.br). *@
    <div vw class="enabled">
        <div vw-access-button class="active"></div>
        <div vw-plugin-wrapper>
            <div class="vw-plugin-top-wrapper"></div>
        </div>
    </div>
    <script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
    <script>
        if (window.VLibras) {
            new window.VLibras.Widget('https://vlibras.gov.br/app');
        }
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
