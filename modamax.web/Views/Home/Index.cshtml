@using modamax.web.Services
@model modamax.web.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Painel";
    var hoje = DateTime.Today;
    var dataExtenso = hoje.ToString("dddd, d 'de' MMMM");
    dataExtenso = char.ToUpper(dataExtenso[0]) + dataExtenso[1..];
}

@functions {
    // Seta e cor da variacao em relacao ao mesmo periodo do mes anterior.
    private Microsoft.AspNetCore.Html.IHtmlContent Variacao(int? variacao)
    {
        if (variacao == null)
        {
            return new Microsoft.AspNetCore.Html.HtmlString("<span class=\"variacao neutra\">sem base de comparação</span>");
        }

        var classe = variacao > 0 ? "positiva" : variacao < 0 ? "negativa" : "neutra";
        var icone = variacao >= 0 ? "i-trending-up" : "i-trending-down";
        var sinal = variacao > 0 ? "+" : "";
        return new Microsoft.AspNetCore.Html.HtmlString(
            $"<span class=\"variacao {classe}\"><svg class=\"icone\" aria-hidden=\"true\"><use href=\"/img/icones.svg#{icone}\" /></svg>{sinal}{variacao}% vs. mês anterior</span>");
    }

    private static string ClasseStatus(string status) => status switch { "Finalizado" => "status-verde", "Cancelado" => "status-vermelho", _ => "status-laranja" };
}

<div class="page-header">
    <div>
        <p class="section-kicker">@dataExtenso</p>
        <h1>@Model.Saudacao, @Model.PrimeiroNome</h1>
        <p class="page-copy">Veja como estão as vendas, as metas e o estoque da ModaMax hoje.</p>
    </div>
    <div class="header-actions">
        <a class="btn btn-outline-secondary" asp-controller="Relatorio" asp-action="Index">
            <svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-chart-column" /></svg>Relatórios
        </a>
        <a class="btn btn-primary" asp-controller="Pedido" asp-action="Create">
            <svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-plus" /></svg>Novo pedido
        </a>
    </div>
</div>

<section class="metrics-grid metrics-grid-primary">
    <article class="metric-card accent-card">
        <span class="metric-icone"><svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-circle-dollar-sign" /></svg></span>
        <span class="metric-label">Faturamento do mês</span>
        <strong>@Model.FaturamentoMes.Atual.ToString("C0")</strong>
        @Variacao(Model.FaturamentoMes.Variacao)
    </article>
    <article class="metric-card">
        <span class="metric-icone" style="background:var(--indigo)"><svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-receipt" /></svg></span>
        <span class="metric-label">Pedidos do mês</span>
        <strong>@Model.PedidosMes.Atual.ToString("0")</strong>
        @Variacao(Model.PedidosMes.Variacao)
    </article>
    <article class="metric-card">
        <span class="metric-icone" style="background:var(--verde-vivo)"><svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-wallet" /></svg></span>
        <span class="metric-label">Ticket médio</span>
        <strong>@Model.TicketMedioMes.Atual.ToString("C0")</strong>
        @Variacao(Model.TicketMedioMes.Variacao)
    </article>
    <article class="metric-card">
        <span class="metric-icone" style="background:var(--laranja-vivo)"><svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-hand-coins" /></svg></span>
        <span class="metric-label">A receber</span>
        <strong>@Model.AReceber.ToString("C0")</strong>
        <span class="variacao neutra">@Model.PedidosAReceber pedido(s) com pagamento pendente</span>
    </article>
    <article class="metric-card quick-link-card">
        <span class="metric-icone" style="background:var(--vermelho-vivo)"><svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-package" /></svg></span>
        <span class="metric-label">Para repor</span>
        <strong>@Model.ProdutosAbaixoDoMinimo</strong>
        <a asp-controller="Reposicao" asp-action="Index">Abrir central <svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-chevron-right" /></svg></a>
    </article>
</section>

<section class="charts-grid">
    @if (Model.Meta != null)
    {
        <article class="content-card">
            <div class="section-heading">
                <div>
                    <p class="section-kicker">Metas · @Model.Meta.NomeMes</p>
                    <h2>Como está o mês</h2>
                </div>
                <a class="btn btn-sm btn-outline-primary" asp-controller="Meta" asp-action="Index">Detalhes</a>
            </div>
            <partial name="_AneisMeta" model="Model.Meta" />
        </article>
    }
    <article class="content-card chart-card">
        <div class="section-heading">
            <div>
                <p class="section-kicker">Vendas</p>
                <h2>Faturamento por mês</h2>
            </div>
        </div>
        <div class="chart-box" style="height:220px">
            <canvas id="grafico-vendas" role="img" aria-label="@string.Join(", ", Model.Graficos.VendasPorMes.Select(p => $"{p.Rotulo}: {p.Valor:C}"))"></canvas>
        </div>
    </article>
    <article class="content-card chart-card">
        <div class="section-heading">
            <div>
                <p class="section-kicker">Produtos</p>
                <h2>Mais vendidos</h2>
            </div>
        </div>
        <div class="chart-box">
            <canvas id="grafico-produtos" role="img" aria-label="@string.Join(", ", Model.Graficos.ProdutosMaisVendidos.Select(p => $"{p.Rotulo}: {p.Valor:0} unidades"))"></canvas>
        </div>
    </article>
    <article class="content-card chart-card">
        <div class="section-heading">
            <div>
                <p class="section-kicker">Pedidos</p>
                <h2>Pedidos por status</h2>
            </div>
        </div>
        <div class="chart-box">
            <canvas id="grafico-status" role="img" aria-label="@string.Join(", ", Model.Graficos.PedidosPorStatus.Select(p => $"{p.Rotulo}: {p.Valor:0}"))"></canvas>
        </div>
    </article>
    <article class="content-card chart-card chart-card-wide">
        <div class="section-heading">
            <div>
                <p class="section-kicker">Estoque</p>
                <h2>Peças em estoque por categoria</h2>
            </div>
        </div>
        <div class="chart-box" style="height:240px">
            <canvas id="grafico-estoque" role="img" aria-label="@string.Join(", ", Model.Graficos.EstoquePorCategoria.Select(p => $"{p.Rotulo}: {p.Valor:0} peças"))"></canvas>
        </div>
    </article>
</section>

<section class="content-grid">
    <article class="content-card">
        <div class="section-heading">
            <div>
                <p class="section-kicker">Vendas</p>
                <h2>Pedidos recentes</h2>
            </div>
            <a class="btn btn-sm btn-outline-primary" asp-controller="Pedido" asp-action="Index">Ver todos</a>
        </div>
        <div class="table-responsive">
            <table class="table table-modern">
                <thead><tr><th>Pedido</th><th>Cliente</th><th>Status</th><th class="text-end">Valor</th></tr></thead>
                <tbody>
                @foreach (var pedido in Model.PedidosRecentes)
                {
                    <tr>
                        <td><a asp-controller="Pedido" asp-action="Details" asp-route-id="@pedido.IdPedido">#@pedido.IdPedido</a></td>
                        <td>@pedido.Cliente?.Nome<small class="d-block text-muted">@pedido.DataPedido.ToString("dd/MM HH:mm") · @Pagamentos.Nome(pedido.FormaPagamento)</small></td>
                        <td><span class="status @ClasseStatus(pedido.Status)">@pedido.Status</span></td>
                        <td class="text-end">@pedido.ValorTotal.ToString("C")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </article>

    <article class="content-card">
        <div class="section-heading">
            <div>
                <p class="section-kicker">Estoque</p>
                <h2>Precisam de reposição</h2>
            </div>
            <a class="btn btn-sm btn-outline-primary" asp-controller="Reposicao" asp-action="Index">Central</a>
        </div>
        @if (Model.ParaRepor.Count == 0)
        {
            <div class="vazio">
                <svg class="icone" aria-hidden="true"><use href="/img/icones.svg#i-circle-check" /></svg>
                <p class="mb-0">Todos os produtos estão com estoque em dia.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-modern">
                    <thead><tr><th>Produto</th><th class="text-end">Estoque</th><th class="text-end">Dura</th><th class="text-end">Comprar</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.ParaRepor)
                    {
                        <tr>
                            <td>
                                <span class="status @(item.Situacao == SituacaoReposicao.Critico ? "status-vermelho" : "status-laranja")" style="padding:0.1rem 0.4rem" aria-hidden="true"></span>
                                <a asp-controller="Produto" asp-action="Details" asp-route-id="@item.IdProduto" style="color:inherit">@item.Produto</a>
                            </td>
                            <td class="text-end">@item.Estoque</td>
                            <td class="text-end">@(item.DiasDeCobertura.HasValue ? $"{item.DiasDeCobertura} dias" : "–")</td>
                            <td class="text-end"><strong>@item.QuantidadeSugerida</strong></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </article>

    @if (Model.LogsRecentes.Count > 0)
    {
        <article class="content-card" style="grid-column: 1 / -1">
            <div class="section-heading">
                <div>
                    <p class="section-kicker">Auditoria</p>
                    <h2>Atividade recente</h2>
                </div>
                <a class="btn btn-sm btn-outline-primary" asp-controller="Log" asp-action="Index">Ver tudo</a>
            </div>
            <div class="table-responsive">
                <table class="table table-modern">
                    <thead><tr><th>Quando</th><th>Quem</th><th>O quê</th></tr></thead>
                    <tbody>
                    @foreach (var log in Model.LogsRecentes)
                    {
                        <tr>
                            <td class="text-nowrap">@log.Data.ToString("dd/MM HH:mm")</td>
                            <td>@(log.Usuario?.Nome ?? "Sistema")</td>
                            <td>@log.Acao</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </article>
    }
</section>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script>
        (function () {
            if (typeof Chart === 'undefined') return;

            const graficos = @Json.Serialize(Model.Graficos);
            const moeda = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 });
            const rotulos = lista => lista.map(p => p.rotulo);
            const valores = lista => lista.map(p => p.valor);
            let instancias = [];

            function desenhar() {
                instancias.forEach(g => g.destroy());
                const c = window.ModaMax.cores();
                Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
                Chart.defaults.color = c.texto;
                Chart.defaults.maintainAspectRatio = false;
                const grade = { color: c.grade };

                const contexto = document.getElementById('grafico-vendas').getContext('2d');
                const degrade = contexto.createLinearGradient(0, 0, 0, 220);
                degrade.addColorStop(0, 'rgba(10, 132, 255, 0.35)');
                degrade.addColorStop(1, 'rgba(10, 132, 255, 0)');

                instancias = [
                    new Chart(contexto, {
                        type: 'line',
                        data: { labels: rotulos(graficos.vendasPorMes), datasets: [{ label: 'Faturamento', data: valores(graficos.vendasPorMes), borderColor: c.azul, backgroundColor: degrade, fill: true, tension: 0.4, pointRadius: 3, borderWidth: 2.5 }] },
                        options: { plugins: { legend: { display: false }, tooltip: { callbacks: { label: x => moeda.format(x.parsed.y) } } }, scales: { x: { grid: { display: false } }, y: { beginAtZero: true, grid: grade, ticks: { callback: v => moeda.format(v) } } } }
                    }),
                    new Chart(document.getElementById('grafico-produtos'), {
                        type: 'bar',
                        data: { labels: rotulos(graficos.produtosMaisVendidos), datasets: [{ label: 'Unidades', data: valores(graficos.produtosMaisVendidos), backgroundColor: c.paleta[1], borderRadius: 8, barThickness: 18 }] },
                        options: { indexAxis: 'y', plugins: { legend: { display: false } }, scales: { x: { beginAtZero: true, grid: grade, ticks: { precision: 0 } }, y: { grid: { display: false } } } }
                    }),
                    new Chart(document.getElementById('grafico-status'), {
                        type: 'doughnut',
                        data: { labels: rotulos(graficos.pedidosPorStatus), datasets: [{ data: valores(graficos.pedidosPorStatus), backgroundColor: rotulos(graficos.pedidosPorStatus).map(r => ({ 'Finalizado': '#30d158', 'Em separação': '#ff9f0a', 'Cancelado': '#ff453a' }[r] || '#0a84ff')), borderWidth: 0, spacing: 3, borderRadius: 6 }] },
                        options: { cutout: '68%', plugins: { legend: { position: 'bottom', labels: { usePointStyle: true } } } }
                    }),
                    new Chart(document.getElementById('grafico-estoque'), {
                        type: 'bar',
                        data: { labels: rotulos(graficos.estoquePorCategoria), datasets: [{ label: 'Peças', data: valores(graficos.estoquePorCategoria), backgroundColor: c.paleta[0], borderRadius: 8, barThickness: 28 }] },
                        options: { plugins: { legend: { display: false } }, scales: { x: { grid: { display: false } }, y: { beginAtZero: true, grid: grade, ticks: { precision: 0 } } } }
                    })
                ];
            }

            desenhar();
            document.addEventListener('modamax:tema', desenhar);
        })();
    </script>
}
